# SQLite (default, local):
DATABASE_URL=sqlite:///lufood.db
# Supabase / PostgreSQL: Project Settings > Database > Connection string
# DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres
LUFOOD_MODEL=models/model.joblib
# Comma-separated origins allowed to call the API from a browser:
LUFOOD_ORIGINS=http://localhost:8000
